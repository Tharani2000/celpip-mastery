# --- Database (required) ---
DATABASE_URL="postgresql://celpip:celpip@localhost:5433/celpip?schema=public"

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- AI evaluation (optional; without a key the app uses a clearly labelled demo mode) ---
# anthropic | openai | demo
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Requests per user per minute for AI endpoints
AI_RATE_LIMIT_PER_MINUTE="6"
AI_TIMEOUT_MS="60000"

# --- Speech-to-text (optional; uses OpenAI's transcription API when OPENAI_API_KEY is set,
#     otherwise falls back to the browser transcript the learner reviews) ---
TRANSCRIPTION_MODEL="whisper-1"

# --- Audio storage for speaking recordings ---
AUDIO_STORAGE_DIR="./storage/audio"
MAX_AUDIO_MB="15"
